{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    { "path": "/api/cron/weekly-digest", "schedule": "0 9 * * 1" },
    { "path": "/api/jobs/send-review-requests", "schedule": "*/5 * * * *" }
  ]
}
