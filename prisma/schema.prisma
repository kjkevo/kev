generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String?
  email     String   @unique
  password  String

  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  twoFactorVerified Boolean  @default(false)

  memberships   TeamMembership[]
  notifications Notification[]

  @@index([email])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  userId     Int?
  userEmail  String?
  action     String
  entityType String?
  entityId   Int?
  meta       String?

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Lead {
  id                  Int                @id @default(autoincrement())
  createdAt           DateTime           @default(now())
  companyName         String
  website             String?
  contactName         String
  title               String
  email               String             @unique
  phone               String?
  triggerEvent        String
  intelligenceSummary String
  notes               String?
  status              String             @default("new")
  tags                String?
  updatedAt           DateTime           @updatedAt
  aiScore             Int?
  aiScoreReason       String?
  aiSuggestion        String?

  // Analytics fields
  dealValue           Float?
  source              String?
  wonAt               DateTime?
  lostAt              DateTime?
  lossReason          String?
  assignedTo          String?

  // Team ownership
  teamId              Int?

  activities          Activity[]
  customFieldValues   CustomFieldValue[]
  notifications       Notification[]

  @@index([email])
  @@index([companyName])
  @@index([status])
  @@index([teamId])
}

model Activity {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  leadId    Int
  type      String
  content   String
  date      DateTime @default(now())
  userId    Int?
  userName  String?
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([leadId])
}

model CustomField {
  id     Int                @id @default(autoincrement())
  name   String             @unique
  values CustomFieldValue[]
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  leadId        Int
  customFieldId Int
  value         String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, customFieldId])
}

model Team {
  id        Int              @id @default(autoincrement())
  createdAt DateTime         @default(now())
  name      String
  members   TeamMembership[]
}

model TeamMembership {
  id       Int      @id @default(autoincrement())
  userId   Int
  teamId   Int
  role     String   @default("rep")
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model PipelineStage {
  id        Int     @id @default(autoincrement())
  userId    Int?
  teamId    Int?
  key       String
  label     String
  color     String  @default("gray")
  position  Int     @default(0)
  isDefault Boolean @default(false)

  @@index([userId])
  @@index([teamId])
}

model Notification {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  userId     Int
  type       String
  content    String
  read       Boolean  @default(false)
  leadId     Int?
  activityId Int?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, read])
}

model BusinessConfig {
  id                  Int       @id @default(autoincrement())
  createdAt           DateTime  @default(now())
  businessName        String
  businessPhone       String    @unique
  ownerPhone          String
  ownerEmail          String
  missedCallMessage   String    @default("Sorry we missed your call! {BUSINESS_NAME} will call you back shortly. Reply here if you'd like to send details now.")
  leadSubmissionMsg   String    @default("Hi {NAME}! Thanks for reaching out to {BUSINESS_NAME}. We got your message and will reply shortly.")

  // Per-business channel behavior (the "voice, text, or both" toggle)
  smsEnabled          Boolean   @default(true)
  voiceEnabled        Boolean   @default(false)
  recordVoicemail     Boolean   @default(false)
  // The words Twilio speaks when voiceEnabled is true
  voiceGreeting       String    @default("Thank you for calling. We're not available right now, but we'll text you shortly.")

  airtableApiKey      String?
  airtableBaseId      String?
  airtableMissedTable String?
  airtableLeadsTable  String?

  missedCalls      MissedCall[]
  leadSubmissions  LeadSubmission[]

  @@index([businessName])
}

model MissedCall {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now())
  businessId      Int
  callerPhone     String
  callerName      String?
  missedAt        DateTime
  textSentAt      DateTime?
  textStatus      String    @default("pending")
  textResponse    String?
  twilio_call_sid String?
  airtableId      String?

  business        BusinessConfig @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([callerPhone])
  @@index([createdAt])
}

model LeadSubmission {
  id                 Int       @id @default(autoincrement())
  createdAt          DateTime  @default(now())
  businessId         Int
  name               String
  phone              String
  serviceRequested   String
  textSentAt         DateTime?
  textStatus         String    @default("pending")
  textResponse       String?
  emailSentToOwner   Boolean   @default(false)
  airtableId         String?

  business           BusinessConfig @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([phone])
  @@index([createdAt])
}
