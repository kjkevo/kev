generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String?
  email     String   @unique
  password  String

  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  twoFactorVerified Boolean  @default(false)

  memberships   TeamMembership[]
  notifications Notification[]

  @@index([email])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  userId     Int?
  userEmail  String?
  action     String
  entityType String?
  entityId   Int?
  meta       Json?

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Lead {
  id                  Int                @id @default(autoincrement())
  createdAt           DateTime           @default(now())
  companyName         String
  website             String?
  contactName         String
  title               String
  email               String             @unique
  phone               String?
  triggerEvent        String
  intelligenceSummary String
  notes               String?
  status              String             @default("new")
  tags                String[]
  updatedAt           DateTime           @updatedAt
  aiScore             Int?
  aiScoreReason       String?
  aiSuggestion        String?

  // Analytics fields
  dealValue           Float?
  source              String?
  wonAt               DateTime?
  lostAt              DateTime?
  lossReason          String?
  assignedTo          String?

  // Team ownership
  teamId              Int?

  activities          Activity[]
  customFieldValues   CustomFieldValue[]
  notifications       Notification[]

  @@index([email])
  @@index([companyName])
  @@index([status])
  @@index([teamId])
}

model Activity {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  leadId    Int
  type      String
  content   String
  date      DateTime @default(now())
  userId    Int?
  userName  String?
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@index([leadId])
}

model CustomField {
  id     Int                @id @default(autoincrement())
  name   String             @unique
  values CustomFieldValue[]
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  leadId        Int
  customFieldId Int
  value         String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, customFieldId])
}

model Team {
  id        Int              @id @default(autoincrement())
  createdAt DateTime         @default(now())
  name      String
  members   TeamMembership[]
}

model TeamMembership {
  id       Int      @id @default(autoincrement())
  userId   Int
  teamId   Int
  role     String   @default("rep")
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model PipelineStage {
  id        Int     @id @default(autoincrement())
  userId    Int?
  teamId    Int?
  key       String
  label     String
  color     String  @default("gray")
  position  Int     @default(0)
  isDefault Boolean @default(false)

  @@index([userId])
  @@index([teamId])
}

model Notification {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  userId     Int
  type       String
  content    String
  read       Boolean  @default(false)
  leadId     Int?
  activityId Int?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, read])
}

model ReviewClient {
  id                      Int               @id @default(autoincrement())
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  name                    String            // Business name
  businessEmail           String            // Owner email for private feedback
  businessPhone           String?
  delayHours              Int               @default(3)
  messageTemplate         String            // Email/SMS message template with {link} placeholder
  googleReviewUrl         String?           // Public review links
  yelpReviewUrl           String?
  airtableBaseId          String?           // For logging
  airtableApiKey          String?           // Encrypted in production
  webhookSecret           String            // For webhook verification
  enabled                 Boolean           @default(true)
  contactName             String?

  requests                ReviewRequest[]

  @@index([name])
}

model ReviewRequest {
  id                      Int               @id @default(autoincrement())
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  clientId                Int
  client                  ReviewClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  customerName            String
  customerEmail           String?
  customerPhone           String?
  jobCompletedAt          DateTime
  sendAfter               DateTime          // When to send the review request
  sent                    Boolean           @default(false)
  sentAt                  DateTime?

  airtableRecordId        String?           // For updating logging

  response                ReviewResponse?

  @@index([clientId])
  @@index([sendAfter])
  @@index([sent])
  @@index([customerEmail])
}

model ReviewResponse {
  id                      Int               @id @default(autoincrement())
  createdAt               DateTime          @default(now())
  requestId               Int               @unique
  request                 ReviewRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  rating                  Int               // 1-5
  feedbackText            String?
  respondedAt             DateTime          @default(now())

  // Routing info
  redirectedToPublic      Boolean           // true if 4-5 stars -> public review
  redirectedUrl           String?           // Which URL they were sent to
  sentToPrivate           Boolean           // true if 1-3 stars -> private feedback
  privateEmailSentAt      DateTime?

  airtableLoggedAt        DateTime?

  @@index([requestId])
  @@index([rating])
}
