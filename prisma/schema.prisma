generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String?
  email     String   @unique
  password  String

  @@index([email])
}

model Lead {
  id                  Int                @id @default(autoincrement())
  createdAt           DateTime           @default(now())
  companyName         String
  website             String?
  contactName         String
  title               String
  email               String             @unique
  phone               String?
  triggerEvent        String
  intelligenceSummary String
  notes               String?
  status              String             @default("new")
  tags                String[]
  updatedAt           DateTime           @updatedAt
  aiScore             Int?
  aiScoreReason       String?
  aiSuggestion        String?

  // Analytics fields
  dealValue           Float?     // expected deal value in USD
  source              String?    // cold_email | referral | paid_ad | linkedin | inbound | event | other
  wonAt               DateTime?  // timestamp when status changed to "won"
  lostAt              DateTime?  // timestamp when status changed to "lost"
  lossReason          String?    // price | timing | competitor | product_fit | no_budget | other
  assignedTo          String?    // name/email of the team member who owns this lead

  activities          Activity[]
  customFieldValues   CustomFieldValue[]

  @@index([email])
  @@index([companyName])
  @@index([status])
}

model Activity {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  leadId    Int
  type      String
  content   String
  date      DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model CustomField {
  id     Int                @id @default(autoincrement())
  name   String             @unique
  values CustomFieldValue[]
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  leadId        Int
  customFieldId Int
  value         String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, customFieldId])
}
