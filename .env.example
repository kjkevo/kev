# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# This stores all your missed calls and leads. Free tier available at supabase.com
#
# Get these connection strings from:
#   1. Go to https://supabase.com and create account/project
#   2. Project → Settings → Database → Connection string
#   3. Copy the "URI" under "PostgreSQL"
#
# DATABASE_URL  → Used by the running app (connection pooler, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL  → Used ONLY for database migrations (direct connection, port 5432)
# ⚠️ Keep this private — never share or commit to git!
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"

# ── Anthropic AI (enrichLeads.ts script only — NOT needed in Vercel) ──────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Admin panel (/admin) ──────────────────────────────────────────────────────
# Shared secret required to add/edit businesses at /admin.
# Generate with: openssl rand -base64 24
ADMIN_API_KEY="..."

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."
# Set to your Vercel deployment URL in production:
NEXTAUTH_URL="https://your-app.vercel.app"

# ── Twilio (for missed call text-back automation) ──────────────────────────────
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="auth_token_here"
# Incoming phone number assigned to your business
TWILIO_PHONE_NUMBER="+1234567890"

# Twilio Webhook URLs to configure in Twilio Console:
# Phone Numbers → Manage Numbers → [Select your number] → Configure these:
# 1. Voice & Fax Configuration:
#    ├─ "A Call Comes In": Webhook → https://your-app.vercel.app/api/webhooks/twilio/incoming-call
#    └─ "Call Status Changes": Webhook → https://your-app.vercel.app/api/webhooks/twilio/call-status
# 2. Messaging Configuration:
#    └─ "A Message Comes In": Webhook → https://your-app.vercel.app/api/webhooks/twilio/sms-inbound

# ── Business Configuration ───────────────────────────────────────────────────────
# These can be set here or in the database (database takes precedence for multi-client)
BUSINESS_NAME="Your Service Business"
BUSINESS_OWNER_PHONE="+1234567890"
BUSINESS_OWNER_EMAIL="owner@yourbusiness.com"
# Message templates (use {BUSINESS_NAME} and {NAME} as placeholders)
MISSED_CALL_MESSAGE="Sorry we missed your call! {BUSINESS_NAME} will call you back shortly. Reply here if you'd like to send details now."
LEAD_SUBMISSION_MESSAGE="Hi {NAME}! Thanks for reaching out to {BUSINESS_NAME}. We got your message and will reply shortly."

# ── Airtable (for logging calls and leads) ────────────────────────────────────
# Get API key from: https://airtable.com/account/tokens
AIRTABLE_API_KEY="key..."
# Base ID: found in Airtable URL (https://airtable.com/appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID="appXXXXXXXXXXXXXX"
# Table IDs for missed calls and leads (create these tables in Airtable first)
AIRTABLE_MISSED_CALLS_TABLE_ID="tblXXXXXXXXXXXXXX"
AIRTABLE_LEADS_TABLE_ID="tblXXXXXXXXXXXXXX"

# ── Email Configuration (for business owner notifications) ───────────────────
# For Gmail: use App Passwords (https://myaccount.google.com/apppasswords)
# For other providers: use your SMTP credentials
EMAIL_SERVICE="gmail"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
# Recommended for reliable inbox delivery: a transactional email service over
# SMTP (Brevo, SendGrid, Resend, Mailgun…). When SMTP_HOST/USER/PASS are set they
# take priority over the Gmail settings above. EMAIL_FROM is the visible sender.
SMTP_HOST=""          # e.g. smtp-relay.brevo.com  |  smtp.sendgrid.net
SMTP_PORT="587"       # 587 (TLS) or 465 (SSL)
SMTP_USER=""          # provider login  (SendGrid: the literal word "apikey")
SMTP_PASS=""          # provider SMTP key / API key
EMAIL_FROM="Slimpse <Slimpsehelp@gmail.com>"
# Where operator alerts (new signups, setup-form submissions, cancellations,
# billing) are sent. Defaults to EMAIL_USER if unset.
ALERT_EMAIL="your-email@gmail.com"
# Public base URL of the app (used to build links in trial reminder emails).
APP_URL="https://your-app.vercel.app"

# ── Stripe billing ───────────────────────────────────────────────────────────
# Create a product + two prices ($49/mo, $490/yr) in the Stripe Dashboard,
# then paste the price IDs here. Leave blank to run without billing (the
# "Add payment" button is hidden until these are set).
STRIPE_SECRET_KEY="sk_live_or_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."   # from the Stripe webhook you point at /api/webhooks/stripe
STRIPE_PRICE_SINGLE="price_...(the $59.99/mo Voice-or-Text price)"
STRIPE_PRICE_BOTH="price_...(the $100/mo Voice + Text price)"

# Voice: any Amazon Polly Neural voice for spoken prompts (natural, not robotic).
# Options: Polly.Joanna-Neural, Polly.Matthew-Neural, Polly.Ruth-Neural, Polly.Danielle-Neural, Polly.Stephen-Neural.
TWILIO_VOICE="Polly.Joanna-Neural"

# Messaging Service that holds your approved A2P campaign. When set, each newly
# provisioned number is auto-attached to it (inherits your brand/campaign), so
# texting works without re-registering per number. Find it under
# Twilio → Messaging → Services (starts with "MG").
TWILIO_MESSAGING_SERVICE_SID="MG..."

# Text AI (Claude): powers conversational SMS replies for businesses with
# "AI text replies" turned on. Without this key, inbound texts are just captured
# (no AI). AI_MODEL is optional (defaults to a fast, low-cost Claude model).
ANTHROPIC_API_KEY="sk-ant-..."
# AI_MODEL="claude-haiku-4-5-20251001"

# Voice AI (Vapi, phase 2). VAPI_API_KEY lets us auto-register numbers with Vapi.
# VAPI_ASSISTANT_ID is a base assistant you create once in the Vapi dashboard
# (model + voice); our /api/webhooks/vapi overrides its system prompt per
# business. Point each Vapi number's Server URL at /api/webhooks/vapi.
VAPI_API_KEY="..."
VAPI_ASSISTANT_ID="..."

# ── GA4 client reporting (agency traffic reports at /report/[slug]) ──────────
# Only needed once you connect a real client's GA4 property — the demo report
# (npm run ga4:seed-demo) works without any of this.
#
# Setup:
#   1. Google Cloud Console → create/select a project → enable the
#      "Google Analytics Data API".
#   2. IAM & Admin → Service Accounts → create one → Keys → Add key → JSON.
#   3. For each client: GA4 Admin → Property access management → add the
#      service account's email (…@…iam.gserviceaccount.com) as a Viewer.
#      No OAuth consent screen or per-client login needed.
#   4. Paste the downloaded JSON below (raw, or base64-encoded — either works).
GA4_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...", ...}'

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` when
# it triggers /api/cron/ga4-pull (and the app's other cron routes). Set any
# random string in production; leave unset in dev to skip the check.
CRON_SECRET="a-long-random-string"
