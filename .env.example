# ── Database (Supabase + Prisma) ──────────────────────────────────────────────
#
# Supabase gives you TWO connection strings. Both are in:
#   Supabase dashboard → Project → Settings → Database → Connection string
#
# DATABASE_URL  → "Transaction" pooler (port 6543)
#   Used by Vercel serverless functions at runtime.
#   Enable pgbouncer=true so Prisma works in transaction mode.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL  → Direct connection (port 5432)
#   Used ONLY by `prisma migrate` — never by the running app.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# ── Anthropic AI (enrichLeads.ts script only — NOT needed in Vercel) ──────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."
# Set to your Vercel deployment URL in production:
NEXTAUTH_URL="https://your-app.vercel.app"

# ── Review & Reputation Management ────────────────────────────────────────────
# Email Service (Resend)
# Sign up: https://resend.com
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# SMS Service (Twilio) - Optional
# Sign up: https://www.twilio.com
TWILIO_ACCOUNT_SID="ACxxx..."
TWILIO_AUTH_TOKEN="xxx..."
TWILIO_PHONE_NUMBER="+1234567890"

# Admin API Key - for creating/managing clients
# Generate with: openssl rand -hex 32
ADMIN_API_KEY="your-secret-admin-key"

# Background Job API Key - for cron job to send review requests
# Generate with: openssl rand -hex 32
REVIEW_JOB_API_KEY="your-secret-job-key"

# Airtable (Optional) - for logging reviews
# Get API key: https://airtable.com/account/tokens
# Get Base ID from URL: https://airtable.com/[BASE_ID]/...
AIRTABLE_API_KEY="key_xxx..."
AIRTABLE_BASE_ID="appXxx..."
