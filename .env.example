# ── Database (Supabase + Prisma) ──────────────────────────────────────────────
#
# Supabase gives you TWO connection strings. Both are in:
#   Supabase dashboard → Project → Settings → Database → Connection string
#
# DATABASE_URL  → "Transaction" pooler (port 6543)
#   Used by Vercel serverless functions at runtime.
#   Enable pgbouncer=true so Prisma works in transaction mode.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL  → Direct connection (port 5432)
#   Used ONLY by `prisma migrate` — never by the running app.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# ── Anthropic AI (enrichLeads.ts script only — NOT needed in Vercel) ──────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."
# Set to your Vercel deployment URL in production:
NEXTAUTH_URL="https://your-app.vercel.app"

# ── Twilio (for missed call text-back automation) ──────────────────────────────
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="auth_token_here"
# Incoming phone number assigned to your business
TWILIO_PHONE_NUMBER="+1234567890"

# ── Business Configuration ───────────────────────────────────────────────────────
# These can be set here or in the database (database takes precedence for multi-client)
BUSINESS_NAME="Your Service Business"
BUSINESS_OWNER_PHONE="+1234567890"
BUSINESS_OWNER_EMAIL="owner@yourbusiness.com"
# Message templates (use {BUSINESS_NAME} and {NAME} as placeholders)
MISSED_CALL_MESSAGE="Sorry we missed your call! {BUSINESS_NAME} will call you back shortly. Reply here if you'd like to send details now."
LEAD_SUBMISSION_MESSAGE="Hi {NAME}! Thanks for reaching out to {BUSINESS_NAME}. We got your message and will reply shortly."

# ── Airtable (for logging calls and leads) ────────────────────────────────────
# Get API key from: https://airtable.com/account/tokens
AIRTABLE_API_KEY="key..."
# Base ID: found in Airtable URL (https://airtable.com/appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID="appXXXXXXXXXXXXXX"
# Table IDs for missed calls and leads (create these tables in Airtable first)
AIRTABLE_MISSED_CALLS_TABLE_ID="tblXXXXXXXXXXXXXX"
AIRTABLE_LEADS_TABLE_ID="tblXXXXXXXXXXXXXX"

# ── Email Configuration (for business owner notifications) ───────────────────
# For Gmail: use App Passwords (https://myaccount.google.com/apppasswords)
# For other providers: use your SMTP credentials
EMAIL_SERVICE="gmail"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
