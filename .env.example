# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# This stores all your missed calls and leads. Free tier available at supabase.com
#
# Get these connection strings from:
#   1. Go to https://supabase.com and create account/project
#   2. Project → Settings → Database → Connection string
#   3. Copy the "URI" under "PostgreSQL"
#
# DATABASE_URL  → Used by the running app (connection pooler, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL  → Used ONLY for database migrations (direct connection, port 5432)
# ⚠️ Keep this private — never share or commit to git!
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"

# ── Anthropic AI (enrichLeads.ts script only — NOT needed in Vercel) ──────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Admin panel (/admin) ──────────────────────────────────────────────────────
# Shared secret required to add/edit businesses at /admin.
# Generate with: openssl rand -base64 24
ADMIN_API_KEY="..."

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."
# Set to your Vercel deployment URL in production:
NEXTAUTH_URL="https://your-app.vercel.app"

# ── Twilio (for missed call text-back automation) ──────────────────────────────
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="auth_token_here"
# Incoming phone number assigned to your business
TWILIO_PHONE_NUMBER="+1234567890"

# Twilio Webhook URLs to configure in Twilio Console:
# Phone Numbers → Manage Numbers → [Select your number] → Configure these:
# 1. Voice & Fax Configuration:
#    ├─ "A Call Comes In": Webhook → https://your-app.vercel.app/api/webhooks/twilio/incoming-call
#    └─ "Call Status Changes": Webhook → https://your-app.vercel.app/api/webhooks/twilio/call-status
# 2. Messaging Configuration:
#    └─ "A Message Comes In": Webhook → https://your-app.vercel.app/api/webhooks/twilio/sms-inbound

# ── Business Configuration ───────────────────────────────────────────────────────
# These can be set here or in the database (database takes precedence for multi-client)
BUSINESS_NAME="Your Service Business"
BUSINESS_OWNER_PHONE="+1234567890"
BUSINESS_OWNER_EMAIL="owner@yourbusiness.com"
# Message templates (use {BUSINESS_NAME} and {NAME} as placeholders)
MISSED_CALL_MESSAGE="Sorry we missed your call! {BUSINESS_NAME} will call you back shortly. Reply here if you'd like to send details now."
LEAD_SUBMISSION_MESSAGE="Hi {NAME}! Thanks for reaching out to {BUSINESS_NAME}. We got your message and will reply shortly."

# ── Airtable (for logging calls and leads) ────────────────────────────────────
# Get API key from: https://airtable.com/account/tokens
AIRTABLE_API_KEY="key..."
# Base ID: found in Airtable URL (https://airtable.com/appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID="appXXXXXXXXXXXXXX"
# Table IDs for missed calls and leads (create these tables in Airtable first)
AIRTABLE_MISSED_CALLS_TABLE_ID="tblXXXXXXXXXXXXXX"
AIRTABLE_LEADS_TABLE_ID="tblXXXXXXXXXXXXXX"

# ── Email Configuration (for business owner notifications) ───────────────────
# For Gmail: use App Passwords (https://myaccount.google.com/apppasswords)
# For other providers: use your SMTP credentials
EMAIL_SERVICE="gmail"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# ── Stripe billing ───────────────────────────────────────────────────────────
# Create a product + two prices ($49/mo, $490/yr) in the Stripe Dashboard,
# then paste the price IDs here. Leave blank to run without billing (the
# "Add payment" button is hidden until these are set).
STRIPE_SECRET_KEY="sk_live_or_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."   # from the Stripe webhook you point at /api/webhooks/stripe
STRIPE_PRICE_MONTHLY="price_...(the $49/mo price)"
STRIPE_PRICE_ANNUAL="price_...(the $490/yr price)"
